# airiam-ticket-triage — local environment template
#
# Copy this file to `.env.local` and fill in the values for your dev environment.
# `.env.local` is gitignored. NEVER commit real secrets.
#
# Authoritative env var reference: AGENTS.md §10.
# Server-only vars never use the `NEXT_PUBLIC_` prefix. Browser-exposed vars must.

# -----------------------------------------------------------------------------
# Supabase (required for v1)
# -----------------------------------------------------------------------------

# Server-side Supabase URL (used by API route handlers).
SUPABASE_URL=

# Anon key for non-admin server paths.
SUPABASE_ANON_KEY=

# Service-role key. Server-only; bypasses RLS.
# NEVER expose to the browser. Constrained to specific Features only.
SUPABASE_SERVICE_ROLE_KEY=

# Browser-visible Supabase URL and anon key. Required only when a client
# component talks to Supabase directly. Safe to expose because the `NEXT_PUBLIC_`
# prefix is intentional and the anon key is RLS-gated.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# LLM (required for v1)
# -----------------------------------------------------------------------------

# Google Generative AI / Gemini API key.
GOOGLE_GENERATIVE_AI_API_KEY=

# Legacy alias; the LLM provider reads `GOOGLE_GENERATIVE_AI_API_KEY` first
# and falls back to `GOOGLE_API_KEY`. Prefer the former for new setups.
# GOOGLE_API_KEY=

# Optional override for the default Gemini model (default: gemini-2.5-flash-lite).
# AI_MODEL=gemini-2.5-flash-lite

# -----------------------------------------------------------------------------
# Linear (required once Phase 4 / Phase 5 land — not used in Phase 0)
# -----------------------------------------------------------------------------

# Linear API key, scoped to the airiamspace workspace.
# LINEAR_API_KEY=

# Target Linear team identifier (team key `AIR`).
# LINEAR_TEAM_ID=

# Shared secret for verifying inbound Linear webhook signatures.
# LINEAR_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Email (required once Phase 6 lands — provider TBD via BL-009)
# -----------------------------------------------------------------------------

# API key for the chosen email provider.
# EMAIL_PROVIDER_API_KEY=

# Sending address. Domain must have SPF/DKIM/DMARC configured (BL-010).
# EMAIL_SENDER=

# -----------------------------------------------------------------------------
# In-app caller authentication (required once Phase 7 lands — mechanism TBD via BL-012)
# -----------------------------------------------------------------------------

# Shared secret for HMAC verification of in-app submissions, assuming the
# working assumption in the architecture doc holds. Per-caller secrets may
# replace this once the auth mechanism is locked.
# IN_APP_CALLER_HMAC_SECRET=
