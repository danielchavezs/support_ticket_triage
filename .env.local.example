# airiam-ticket-triage — local environment template
#
# Copy this file to `.env.local` and fill in the values for your dev environment.
# `.env.local` is gitignored. NEVER commit real secrets.
#
# Authoritative env var reference: AGENTS.md §10.
# Server-only vars never use the `NEXT_PUBLIC_` prefix. Browser-exposed vars must.

# -----------------------------------------------------------------------------
# Supabase (required for v1)
# -----------------------------------------------------------------------------
#
# Supabase ships two key formats per project. Modern (recommended):
#   - `sb_publishable_...`  — browser-safe, RLS-respecting, replaces the
#                              legacy `anon` JWT.
#   - `sb_secret_...`        — server-only, BYPASSES RLS, replaces the
#                              legacy `service_role` JWT.
# Legacy JWT keys still function. Either form works in the env vars below;
# the `@supabase/ssr` and `@supabase/supabase-js` clients accept both.
#
# Naming: we use the new "publishable / secret" vocabulary to align with
# Supabase's current docs and to make the privilege level obvious from the
# variable name.

# Supabase URL. Same value the browser sees; reading server-side from the
# `NEXT_PUBLIC_` variable is fine because URLs are not secrets.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key for server-side, non-admin paths (the server.ts and
# public.ts clients). RLS still applies; this client cannot bypass it.
SUPABASE_PUBLISHABLE_KEY=

# Publishable key visible to the browser. Required only when a client
# component talks to Supabase directly. Same value as SUPABASE_PUBLISHABLE_KEY;
# the `NEXT_PUBLIC_` prefix tells Next.js to inline it at build time.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key. Server-only; BYPASSES RLS. Used by the admin client for
# service-role paths. NEVER expose to the browser; never use the
# `NEXT_PUBLIC_` prefix on this var.
SUPABASE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Dev defaults (Phase 1 only — the internal dashboard caller)
# -----------------------------------------------------------------------------
#
# The seeded `ATD-internal` org and dev user from
# `migrations/dev/2026-05-13_seed_dev_default.sql`. The dashboard's client
# code reads these and includes them on every API call as `orgId` / `userId`,
# since v1 does not yet have a real caller-authentication mechanism (Phase 7,
# BL-012). Replace them when calling apps start signing their own requests.

NEXT_PUBLIC_DEV_ORG_ID=00000000-0000-0000-0000-0000000000a0
NEXT_PUBLIC_DEV_USER_ID=00000000-0000-0000-0000-0000000000a1

# -----------------------------------------------------------------------------
# LLM (required for v1)
# -----------------------------------------------------------------------------

# Google Generative AI / Gemini API key.
GOOGLE_GENERATIVE_AI_API_KEY=

# Legacy alias; the LLM provider reads `GOOGLE_GENERATIVE_AI_API_KEY` first
# and falls back to `GOOGLE_API_KEY`. Prefer the former for new setups.
# GOOGLE_API_KEY=

# Optional override for the default Gemini model.
# Phase 3.5 bumps the default to `gemini-3-flash-preview` for the bounded
# tool-loop in triage classification. Leave unset to use the default;
# override here only if Google ships a different canonical identifier or
# you want to pin a specific model revision.
# AI_MODEL=gemini-3-flash-preview

# -----------------------------------------------------------------------------
# Embedding model (required once Phase 3 vector dedup is exercised)
# -----------------------------------------------------------------------------
#
# Phase 3 uses OpenAI `text-embedding-3-large` truncated to 1536 dimensions
# (BL-007). The classification path (above) continues to use Gemini; only
# the dedup-Feature embedding call talks to OpenAI.
#
# Deterministic-hash dedup runs without this key. Vector dedup only triggers
# when `org_settings.vector_dedup_enabled = true` for the calling org; until
# then this key is unused.

# OpenAI API key for embedding generation.
OPENAI_API_KEY=

# Optional override for the embedding model (default: text-embedding-3-large).
# AI_EMBEDDING_MODEL=text-embedding-3-large

# Optional override for the embedding dimension (default: 1536). MUST match
# the `vector(N)` column type in the tickets table — changing it requires the
# matching schema migration. See `migrations/2026-05-14_10_constrain_description_embedding.sql`.
# AI_EMBEDDING_DIMENSIONS=1536

# -----------------------------------------------------------------------------
# Linear (Phase 4 outbound + Phase 5 inbound)
# -----------------------------------------------------------------------------
#
# Provision a Linear API key from https://linear.app/settings/account/security
# scoped to the `airiamspace` workspace. The key is per-environment: never
# reuse a prod key in dev. Phase 4's outbound push fails fast if this is
# missing once the Linear push wires into the pipeline.

# Linear personal API key (server-only). NEVER expose to the browser.
LINEAR_API_KEY=

# Target Linear team UUID. Default for the ATD team in `airiamspace` is
# documented in AGENTS.md §8 (team key `AIR`,
# `c66f57f7-2728-4ea5-86e0-dc6f7907a869`). Override per-environment if a
# dev team is preferred for `deployed-dev`.
LINEAR_TEAM_ID=

# Shared secret for verifying inbound Linear webhook signatures (Phase 5).
# Configured in the Linear workspace's webhook settings; copied here verbatim.
# LINEAR_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Email (required once Phase 6 lands — provider TBD via BL-009)
# -----------------------------------------------------------------------------

# API key for the chosen email provider.
# EMAIL_PROVIDER_API_KEY=

# Sending address. Domain must have SPF/DKIM/DMARC configured (BL-010).
# EMAIL_SENDER=

# -----------------------------------------------------------------------------
# In-app caller authentication (required once Phase 7 lands — mechanism TBD via BL-012)
# -----------------------------------------------------------------------------

# Shared secret for HMAC verification of in-app submissions, assuming the
# working assumption in the architecture doc holds. Per-caller secrets may
# replace this once the auth mechanism is locked.
# IN_APP_CALLER_HMAC_SECRET=
